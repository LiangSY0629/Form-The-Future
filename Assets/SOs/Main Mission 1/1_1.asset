  dialogueLines:
  - dialogueName: "\u5927\u80A5\u9C7C"
    dialogueText: "\u4F60\u9192\u4E86\uFF1F\u5FEB\u548C\u6211\u4E00\u8D77\u62EF\u6551\u4E16\u754C\u5427\uFF01"
    dialogueEffects: []
  - dialogueName: "\u54F2"
    dialogueText: "\u4F60\u8C01\u554A\u4F60\uFF1F\u4F60\u600E\u4E48\u8FDB\u6765\u7684\uFF1F\uFF1F\uFF1F"
    dialogueEffects: []
  - dialogueName: "\u5927\u80A5\u9C7C"
    dialogueText: "\u5148\u522B\u7BA1\u90A3\u4E9B\u6709\u7684\u6CA1\u5F97\uFF0C\u6211\u662F\u4ECE\u672A\u6765\u6765\u7684\u7A7F\u8D8A\u8005\uFF0C\u4F60\u8981\u76F8\u4FE1\u6211\uFF0C\u672A\u6765\u5730\u7403\u4F1A\u906D\u9047\u4E00\u573A\u7A7A\u524D\u7EDD\u540E\u7684\u5927\u707E\u96BE\uFF0C99%\u7684\u4EBA\u7C7B\u4F1A\u88AB\u6BC1\u706D\uFF0C\u6211\u8FD9\u6B21\u56DE\u6765\u5C31\u662F\u4E3A\u4E86\u62EF\u6551\u5730\u7403\uFF01"
    dialogueEffects: []
  dialogueChooses:
  - chooseText: "\u4FE1\u4F60\u662F\u7A7F\u8D8A\u8005\u4E0D\u5982\u4FE1\u6211\u662F\u79E6\u59CB\u7687"
    nextID: 1_2
  - chooseText: "\u4F60\u770B\u6211\u50CF\u5565\u5B50\u5417\uFF1F"
    nextID: 1_2
  references:
    version: 2
    RefIds: []
