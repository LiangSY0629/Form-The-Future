  paragraphID: 1_1
  dialogueParagraph:
  - dialogueName: "\u5927\u80A5\u9C7C"
    dialogueText: "\u4F60\u9192\u4E86\uFF1F"
    dialogueEffects: []
  - dialogueName: "\u54F2"
    dialogueText: "\u4F60\u8C01\u554A\u4F60\uFF1F\uFF01\u4E3A\u4EC0\u4E48\u4F1A\u51FA\u73B0\u5728\u6211\u5BB6\uFF1F"
    dialogueEffects: []
  - dialogueName: "\u54F2"
    dialogueText: "\u96BE\u4E0D\u6210\u4F60\u662F\u5165\u5BA4\u62A2\u52AB\u7684\u7F6A\u72AF\uFF0C\u89CA\u89CE\u6211\u7684\u7F8E\u8C8C\u6240\u4EE5\u60F3\u5BF9\u6211\u5B9E\u65BD\u4FB5\u72AF\uFF1F"
    dialogueEffects: []
  - dialogueName: "\u54F2"
    dialogueText: "\u6211\u544A\u8BC9\u4F60\uFF0C\u6211\u53EF\u662F\u826F\u5BB6\u5C11\u7537\uFF0C\u4E0D\u4F1A\u540C\u4F60\u505A\u8FD9\u79CD\u82DF\u4E14\u4E4B\u4E8B\u7684\uFF0C\u4F60\u522B\u8FC7\u6765\uFF0C\u6211\u8B66\u544A\u4F60\uFF0C\u4E0D\u7136\uFF0C\u6211\u5C31\u62A5\u8B66\u4E86\uFF01"
    dialogueEffects: []
  - dialogueName: "\u5927\u80A5\u9C7C"
    dialogueText: "\u4F60\u662F\u4E0D\u662F\u5BF9\u81EA\u5DF1\u6709\u70B9\u8FC7\u4E8E\u81EA\u4FE1\u4E86......"
    dialogueEffects: []
  - dialogueName: "\u5927\u80A5\u9C7C"
    dialogueText: "\u4F60\u5148\u522B\u62A5\u8B66\uFF0C\u542C\u6211\u89E3\u91CA\uFF0C\u6211\u662F\u4ECE\u672A\u6765\u7A7F\u8D8A\u8FC7\u6765\u7684\uFF0C\u662F\u4E3A\u4E86\u963B\u6B62ai\u53D1\u52A8\u53DB\u4E71\u706D\u7EDD\u4EBA\u7C7B\uFF01"
    dialogueEffects: []
  isChoose: 0
  dialogueChooses: []
  references:
    version: 2
    RefIds: []
